# Copia este archivo como .env y cambia las contraseñas.

# --- Web ---
# Puerto en tu PC donde se abre NOVA: http://localhost:8080
WEB_PORT=8080

# --- Base de datos (MySQL) ---
MYSQL_ROOT_PASSWORD=cambia_esto_root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nova
DB_USER=nova
DB_PASSWORD=cambia_esto

# --- Sesiones y cuentas ---
# URL pública de NOVA (se usa en los enlaces de los correos)
APP_URL=http://localhost:8080
# Cadena larga y aleatoria. Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
# Ponlo en true solo cuando NOVA se sirva por HTTPS
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=168
# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@nova.local
ADMIN_PASSWORD=cambia_esto_admin

# --- Correo ---
# Desarrollo: Mailpit (incluido en docker compose). Bandeja en http://localhost:8025
# Producción: los datos SMTP del correo institucional (p. ej. smtp.office365.com:587 o smtp.gmail.com:465 con SMTP_SECURE=true)
# Si SMTP_HOST queda vacío, los enlaces se imprimen en el log de la API.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NOVA <no-reply@nova.local>

# --- Modelo de IA (ver README, sección "Modelo de IA") ---
# Contenedores opcionales a levantar. Con un proveedor de pago puedes dejarlo vacío.
COMPOSE_PROFILES=ollama
# Modelos que descarga Ollama al arrancar (separados por espacio)
OLLAMA_PULL_MODELS=qwen2.5:3b bge-m3
OLLAMA_CONTEXT_LENGTH=8192

# Chat. openai = cualquier API compatible con OpenAI (Ollama incluido). fake = sin modelo (pruebas)
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embeddings (búsqueda en el corpus). Si cambias el modelo, reindexa el corpus.
EMBED_PROVIDER=openai
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
